{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bgd_sce_tools",
  "version": "0.0.0-dev",
  "identifier": "com.bgd.sce-tools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bgd_sce_tools",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/woaye168/bgd_sce_tools/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQzNGQjU0OUM1NkRCRUUKUldUdTIxYWNWUHZETzJCMXgrUmpCbjFtNlFreTYyWEtaRG0xbkh4elpBN3lrNHhWc0NPTVZFZEIK"
    }
  }
}
